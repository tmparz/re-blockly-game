{
  "name": "blocky-easy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "validate:levels": "node scripts/validate-levels.mjs",
    "validate:source": "node scripts/check-source-lines.mjs",
    "check": "node scripts/check-source-lines.mjs && node scripts/validate-levels.mjs",
    "build": "node scripts/check-source-lines.mjs && node scripts/build-static.mjs",
    "deploy:cloudflare": "npm run build && wrangler pages deploy dist --project-name blocky-easy"
  }
}
